generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Schools {
  id                   String    @id @default(cuid())
  name                 String
  location             String
  tiers                Tiers
  category             Category
  status               Status    @default(APPLYING)
  priority             Priority  @default(LOW)
  ms_status            MsStatus  @default(RESEARCH_BASED)
  logo                 String    @default("")
  removal_reason       String?   @default("")
  removed              Boolean   @default(false)
  more_info_notes      String?   @default("")
  gre                  GreStatus @default(NOT_REQUIRED)
  recommendation_count Int       @default(3)
  non_thesis_option    Boolean   @default(false)
  professional_masters Boolean   @default(false)
  duration             String?   @default("")
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum MsStatus {
  RESEARCH_BASED
  PROFESSIONAL_TRACK
  NO_MASTERS
}

enum Tiers {
  SAFETY
  TARGET
  REACH
  NOT_SURE
}

enum Category {
  AROUND_ILLINOIS
  IN_CHICAGO
  IN_ILLINOIS
  IN_CALIFORNIA
  FAR
}

enum Status {
  APPLYING
  APPLIED
  REJECTED
  ACCEPTED
  REMOVED
}

enum GreStatus {
  REQUIRED
  OPTIONAL
  NOT_REQUIRED
}
