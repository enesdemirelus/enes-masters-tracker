generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Schools {
  id                   String    @id @default(cuid())
  name                 String
  location             String
  status               Status    @default(APPLYING)
  priority             Priority  @default(OTHERS)
  logo                 String    @default("")
  removal_reason       String?   @default("")
  removed              Boolean   @default(false)
  more_info_notes      String?   @default("")
  gre                  GreStatus @default(NOT_REQUIRED)
  recommendation_count Int       @default(3)
  non_thesis_option    Boolean   @default(false)
  professional_masters Boolean   @default(false)
  duration             String?   @default("")

  /// Manual list order (drag-to-reorder); 0 for rows that predate the feature.
  sort_order Int @default(0)

  apply_option      ApplyOption @default(UNDECIDED)
  apply_option_note String      @default("")

  deadline        DateTime?
  application_fee Int?
  program_url     String?   @default("")
  portal_url      String?   @default("")
  applied_date    DateTime?
  decision_date   DateTime?

  checklist ChecklistItem[]
  letters   LetterRequest[]
}

model ChecklistItem {
  id        String  @id @default(cuid())
  school_id String
  school    Schools @relation(fields: [school_id], references: [id], onDelete: Cascade)
  title     String
  done      Boolean @default(false)
  order     Int     @default(0)
}

model Recommender {
  id      String          @id @default(cuid())
  name    String
  email   String          @default("")
  notes   String          @default("")
  letters LetterRequest[]
}

model LetterRequest {
  id             String       @id @default(cuid())
  school_id      String
  recommender_id String
  status         LetterStatus @default(NOT_ASKED)
  school         Schools      @relation(fields: [school_id], references: [id], onDelete: Cascade)
  recommender    Recommender  @relation(fields: [recommender_id], references: [id], onDelete: Cascade)

  @@unique([school_id, recommender_id])
}

enum LetterStatus {
  NOT_ASKED
  ASKED
  AGREED
  SUBMITTED
}

enum Priority {
  MAIN
  OTHERS
}

enum ApplyOption {
  NON_THESIS
  PROFESSIONAL
  BOTH
  UNDECIDED
}

enum Status {
  APPLYING
  APPLIED
  REJECTED
  ACCEPTED
  REMOVED
}

enum GreStatus {
  REQUIRED
  OPTIONAL
  NOT_REQUIRED
}
