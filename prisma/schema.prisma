generator client {
  provider = "prisma-client-js"
  output   = "../app/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Schools {
  id                   String    @id @default(cuid())
  name                 String
  location             String
  tiers                Tiers
  category             Category
  status               Status    @default(APPLYING)
  priority             Priority  @default(LOW)
  ms_status            MsStatus  @default(RESEARCH_BASED)
  logo                 String    @default("")
  removal_reason       String?   @default("")
  removed              Boolean   @default(false)
  more_info_notes      String?   @default("")
  gre                  GreStatus @default(NOT_REQUIRED)
  recommendation_count Int       @default(3)
  non_thesis_option    Boolean   @default(false)
  professional_masters Boolean   @default(false)
  duration             String?   @default("")

  deadline        DateTime?
  application_fee Int?
  program_url     String?   @default("")
  portal_url      String?   @default("")
  applied_date    DateTime?
  decision_date   DateTime?

  checklist ChecklistItem[]
  letters   LetterRequest[]
}

model ChecklistItem {
  id        String  @id @default(cuid())
  school_id String
  school    Schools @relation(fields: [school_id], references: [id], onDelete: Cascade)
  title     String
  done      Boolean @default(false)
  order     Int     @default(0)
}

model Recommender {
  id      String          @id @default(cuid())
  name    String
  email   String          @default("")
  notes   String          @default("")
  letters LetterRequest[]
}

model LetterRequest {
  id             String       @id @default(cuid())
  school_id      String
  recommender_id String
  status         LetterStatus @default(NOT_ASKED)
  school         Schools      @relation(fields: [school_id], references: [id], onDelete: Cascade)
  recommender    Recommender  @relation(fields: [recommender_id], references: [id], onDelete: Cascade)

  @@unique([school_id, recommender_id])
}

enum LetterStatus {
  NOT_ASKED
  ASKED
  AGREED
  SUBMITTED
}

enum Priority {
  HIGH
  MEDIUM
  LOW
}

enum MsStatus {
  RESEARCH_BASED
  PROFESSIONAL_TRACK
  NO_MASTERS
}

enum Tiers {
  SAFETY
  TARGET
  REACH
  NOT_SURE
}

enum Category {
  AROUND_ILLINOIS
  IN_CHICAGO
  IN_ILLINOIS
  IN_CALIFORNIA
  FAR
}

enum Status {
  APPLYING
  APPLIED
  REJECTED
  ACCEPTED
  REMOVED
}

enum GreStatus {
  REQUIRED
  OPTIONAL
  NOT_REQUIRED
}
